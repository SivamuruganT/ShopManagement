# MongoDB Atlas connection string - from Atlas dashboard: Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecbill?retryWrites=true&w=majority

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Render sets PORT automatically - only needed for local dev
PORT=4000
